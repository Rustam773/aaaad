Sampling of an Analog Signal
f = 5;
fs = 20;
t = 0:0.001:10;

x = sin(2*pi*f*t);

ts = 0:1/fs:10;
xs = sin(2*pi*f*ts);

plot(t,x,'b');
hold on;
stem(ts,xs,'r');

grid on;
xlabel('Time');
ylabel('Amplitude');
legend('Original Signal','Sampled Signal');
title('Sampling of an Analog Signal');

Quantization of a Signal
n = 0:49;
x = sin(0.2*pi*n);

q = 0.2;
xq = round(x/q)*q;

stem(n,xq);
grid on;
xlabel('n');
ylabel('Amplitude');
title('Quantized Signal');

Sampling of a Random Signal Using Different
t = 0:0.001:1;
x = rand(size(t));

fs1 = 20;
fs2 = 50;
fs3 = 100;

t1 = 0:1/fs1:1;
t2 = 0:1/fs2:1;
t3 = 0:1/fs3:1;

x1 = interp1(t,x,t1);
x2 = interp1(t,x,t2);
x3 = interp1(t,x,t3);

subplot(4,1,1);
plot(t,x);
title('Original Signal');

subplot(4,1,2);
stem(t1,x1);
title('Sampling at 20 Hz');

subplot(4,1,3);
stem(t2,x2);
title('Sampling at 50 Hz');

subplot(4,1,4);
stem(t3,x3);
title('Sampling at 100 Hz');

